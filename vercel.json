{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/pricing",
      "destination": "/api/pricing"
    },
    {
      "source": "/api/admin/pricing",
      "destination": "/api/admin/pricing"
    },
    {
      "source": "/api/admin/promo-codes",
      "destination": "/api/admin/promo-codes"
    },
    {
      "source": "/api/admin/codes-promo",
      "destination": "/api/admin/codes-promo"
    },
    {
      "source": "/api/admin/stats",
      "destination": "/api/admin/stats"
    },
    {
      "source": "/api/admin/transactions",
      "destination": "/api/admin/transactions"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/admin/users"
    },
    {
      "source": "/api/moneyfusion/checkout",
      "destination": "/api/moneyfusion/checkout"
    },
    {
      "source": "/api/moneyfusion/verify",
      "destination": "/api/moneyfusion/verify"
    },
    {
      "source": "/api/webhooks/moneyfusion",
      "destination": "/api/webhooks/moneyfusion"
    },
    {
      "source": "/api/wallet/pay",
      "destination": "/api/wallet/pay"
    },
    {
      "source": "/api/promo/validate",
      "destination": "/api/promo/validate"
    },
    {
      "source": "/api/promo/valider",
      "destination": "/api/promo/valider"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
