{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stored candidate profile information, credits, and experiences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "personalInfo": {
          "type": "object",
          "description": "Personal and contact information"
        },
        "experiences": {
          "type": "array",
          "description": "List of professional experiences"
        },
        "education": {
          "type": "array",
          "description": "List of degrees and education"
        },
        "skills": {
          "type": "array",
          "description": "List of skill categories"
        },
        "languages": {
          "type": "array",
          "description": "List of languages spoken"
        },
        "credits": {
          "type": "number",
          "description": "Active document generation credits"
        },
        "subscriptionStatus": {
          "type": "string",
          "description": "Account subscription tier"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "UserDocument": {
      "title": "UserDocument",
      "description": "Stored CV or Cover Letter generated by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner Auth User ID"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the document"
        },
        "generationMode": {
          "type": "string",
          "enum": ["cv_only", "letter_only", "full_pack"],
          "description": "Document type mode"
        },
        "isPaid": {
          "type": "boolean",
          "description": "Whether the document paywall has been unlocked"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when last updated"
        }
      },
      "required": ["userId", "generationMode", "isPaid", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Payment attempt or document generation order record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "success", "cancel"]
        },
        "userId": {
          "type": "string"
        }
      },
      "required": ["mode", "price", "createdAt", "paymentStatus"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record under user profile for Dokya Business",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Nom du client ou Entreprise"
        },
        "phone": {
          "type": "string",
          "description": "Numéro WhatsApp (+221...)"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "ninea": {
          "type": "string"
        },
        "paymentTerms": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["name", "phone"]
    },
    "BusinessInvoice": {
      "title": "BusinessInvoice",
      "description": "Invoice or Quote linked to customer and financial tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "customerPhone": {
          "type": "string"
        },
        "docNumber": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["devis", "facture"]
        },
        "totalTTC": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["PAID", "UNPAID"]
        },
        "issueDate": {
          "type": "string"
        },
        "dueDate": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["docNumber", "type", "totalTTC", "status"]
    },
    "Business": {
      "title": "Business",
      "description": "Stored issuer businesses per user with contact details and logo",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "companyName": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "ninea": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string"
        },
        "isDefault": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["companyName"]
    }
  },
  "firestore": {
    "/user_profiles/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Collection of candidate profiles"
    },
    "/users/{userId}/businesses/{businessId}": {
      "schema": {
        "$ref": "#/entities/Business"
      },
      "description": "Collection of issuer businesses per user"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": {
        "$ref": "#/entities/Customer"
      },
      "description": "Collection of business customers per user"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": {
        "$ref": "#/entities/BusinessInvoice"
      },
      "description": "Collection of business invoices and quotes per user"
    },
    "/user_documents/{docId}": {
      "schema": {
        "$ref": "#/entities/UserDocument"
      },
      "description": "Collection of user created CVs and Cover Letters"
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Collection of payment orders and generation attempts"
    }
  }
}
