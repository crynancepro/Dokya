# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
NEXT_PUBLIC_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / NEXT_PUBLIC_APP_URL: Domaine marchand de l'application.
# Requis par SenePay pour valider les URLs de redirection de paiement (return_url / cancel_url).
# Pour Vercel: https://cv-ia-self.vercel.app
APP_URL="https://cv-ia-self.vercel.app"
NEXT_PUBLIC_APP_URL="https://cv-ia-self.vercel.app"
VITE_APP_URL="https://cv-ia-self.vercel.app"

# SENEPAY PAYMENT INTEGRATION
# Clés d'API SenePay pour le guichet Checkout hébergé (https://api.sene-pay.com)
SENEPAY_API_KEY="votre_cle_api_senepay"
SENEPAY_SECRET_KEY="votre_cle_secrete_senepay"
VITE_SENEPAY_PUBLIC_KEY="pk_live_votre_cle_publique_senepay"
VITE_SENEPAY_SECRET_KEY="votre_cle_secrete_senepay"
NEXT_PUBLIC_SENEPAY_PUBLIC_KEY="pk_live_votre_cle_publique_senepay"

