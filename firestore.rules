rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'peter25ngouala@gmail.com',
          'admin1@gmail.com',
          'admin1@gamil.com'
        ] ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isIncomingDocOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Profils Utilisateurs et sous-collections
    match /users/{userId} {
      // Lecture et mise à jour autorisées (crédit solde, abonnement VIP via webhook et gestion profil)
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      // Sous-collections privées de l'utilisateur
      match /customers/{customerId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isSignedIn();
      }

      match /businesses/{businessId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isSignedIn();
      }

      match /invoices/{invoiceId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isSignedIn();
      }

      match /documents/{docId} {
        allow read, write, delete: if true;
      }

      // Filleuls parrainés
      match /referrals/{refId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isSignedIn();
      }

      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }

    // Profil candidat
    match /user_profiles/{userId} {
      allow read, write: if true;
      allow delete: if isOwner(userId) || isAdmin() || isSignedIn();
    }

    // Verrous de paiement atomiques (anti-doublon et anti-collision)
    match /payment_locks/{lockId} {
      allow read, write: if true;
    }

    // 2. Documents & CV générés (déblocage immédiat par webhooks)
    match /user_documents/{docId} {
      allow read, list, write, create, update: if true;
      allow delete: if isDocOwner() || isAdmin() || isSignedIn();
    }

    match /documents/{docId} {
      allow read, list, write, create, update: if true;
      allow delete: if isDocOwner() || isAdmin() || isSignedIn();
    }

    match /generated_cvs/{cvId} {
      allow read, list, write, create, update: if true;
      allow delete: if isDocOwner() || isAdmin() || isSignedIn();
    }

    // 3. Produits & Inventaire
    match /inventory/{itemId} {
      allow read, list: if true;
      allow create, update, delete: if isSignedIn() || isAdmin();
    }

    match /products/{productId} {
      allow read, list: if true;
      allow create, update, delete: if isSignedIn() || isAdmin();
    }

    match /notifications/{notifId} {
      allow read, list: if true;
      allow create, update, delete: if isSignedIn() || isAdmin();
    }

    match /businesses/{businessId} {
      allow read, write: if true;

      match /products/{productId} {
        allow read, list: if true;
        allow create, update, delete: if isSignedIn() || isAdmin();
      }

      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }

    // 4. Transactions & Paiements (Money Fusion, Wave, Orange Money, etc.)
    match /transactions/{txId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /manual_payments/{paymentId} {
      allow read, list: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 5. Affiliation & Parrainage
    match /affiliate_commissions/{commissionId} {
      allow read, list: if true;
      allow create: if isSignedIn() || true;
      allow update, delete: if isAdmin();
    }

    match /affiliate_payout_requests/{requestId} {
      allow read, list: if true;
      allow create: if isSignedIn() || true;
      allow update, delete: if isAdmin();
    }

    // 6. Support & Messagerie (chat en direct hybride IA + conseiller humain)
    match /support_conversations/{convId} {
      allow read, write, delete: if true;

      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }

    match /support_chats/{chatId} {
      allow read, write, delete: if true;

      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }

    // 7. Paramètres publics et audit
    match /settings_pricing/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promo_codes/{promoId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
