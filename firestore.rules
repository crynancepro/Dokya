rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'peter25ngouala@gmail.com' ||
        request.auth.token.email == 'admin1@gmail.com' ||
        request.auth.token.email == 'admin1@gamil.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if true;

      match /customers/{customerId} {
        allow read, write, delete: if true;
      }

      match /businesses/{businessId} {
        allow read, write, delete: if true;
      }

      match /invoices/{invoiceId} {
        allow read, write, delete: if true;
      }

      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }

    match /businesses/{businessId} {
      allow read, write, delete: if true;

      match /products/{productId} {
        allow read, write, delete: if true;
      }

      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }

    match /user_profiles/{userId} {
      allow read, write: if true;
    }

    match /user_documents/{docId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /documents/{docId} {
      allow read, write: if true;
    }

    match /generated_cvs/{cvId} {
      allow read, write: if true;
    }

    match /transactions/{txId} {
      allow read, write, delete: if true;
    }

    match /settings_pricing/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /promo_codes/{promoId} {
      allow read: if true;
      allow write, delete: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /affiliate_commissions/{commissionId} {
      allow read, write, delete: if true;
    }

    match /affiliate_payout_requests/{requestId} {
      allow read, write, delete: if true;
    }

    match /support_conversations/{convId} {
      allow read, write, delete: if true;

      match /messages/{messageId} {
        allow read, write, delete: if true;
      }
      
      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }

    match /support_chats/{chatId} {
      allow read, write, delete: if true;

      match /messages/{messageId} {
        allow read, write, delete: if true;
      }
      
      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }

    match /test/connection {
      allow read: if true;
    }
  }
}

