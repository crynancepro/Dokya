rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'peter25ngouala@gmail.com',
          'admin1@gmail.com',
          'admin1@gamil.com'
        ] ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isIncomingDocOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Profils Utilisateurs et sous-collections
    match /users/{userId} {
      // Lecture autorisée pour l'utilisateur connecté ou l'administrateur
      // Permet aussi la recherche de code parrain (referralCode) entre utilisateurs authentifiés
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin() || (
        isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalReferred', 'updatedAt'])
      );
      allow delete: if isAdmin();

      // Sous-collections privées de l'utilisateur
      match /customers/{customerId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      match /businesses/{businessId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      match /invoices/{invoiceId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      match /documents/{docId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      // Filleuls parrainés
      match /referrals/{refId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isSignedIn();
      }

      match /{allSubcollections=**} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Profil candidat
    match /user_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write, delete: if isOwner(userId) || isAdmin();
    }

    // 2. Documents & CV générés (isolation stricte par userId)
    match /user_documents/{docId} {
      allow read: if isDocOwner() || isAdmin();
      allow list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isIncomingDocOwner() || isAdmin();
      allow update, delete: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
    }

    match /documents/{docId} {
      allow read: if isDocOwner() || isAdmin();
      allow list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isIncomingDocOwner() || isAdmin();
      allow update, delete: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
    }

    match /generated_cvs/{cvId} {
      allow read: if isDocOwner() || isAdmin();
      allow list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isIncomingDocOwner() || isAdmin();
      allow update, delete: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
    }

    // 3. Produits & Inventaire (isolation stricte par userId)
    match /products/{productId} {
      allow read: if isDocOwner() || isAdmin();
      allow list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isIncomingDocOwner() || isAdmin();
      allow update, delete: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
    }

    match /businesses/{businessId} {
      allow read, write: if isSignedIn();

      match /products/{productId} {
        allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isIncomingDocOwner() || isAdmin();
        allow update, delete: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
      }

      match /{allSubcollections=**} {
        allow read, write, delete: if isSignedIn();
      }
    }

    // 4. Transactions & Paiements (isolation stricte par userId)
    match /transactions/{txId} {
      allow read: if isDocOwner() || isAdmin();
      allow list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isIncomingDocOwner() || isAdmin();
      allow update: if isDocOwner() || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isDocOwner() || isAdmin();
      allow list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isIncomingDocOwner() || isAdmin();
      allow update, delete: if isDocOwner() || isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isDocOwner() || isAdmin();
      allow list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isIncomingDocOwner() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /manual_payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 5. Affiliation & Parrainage
    match /affiliate_commissions/{commissionId} {
      allow read, list: if isSignedIn() && (
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredUserId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /affiliate_payout_requests/{requestId} {
      allow read, list: if isSignedIn() && (
        resource.data.affiliateId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.affiliateId == request.auth.uid || 
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 6. Support & Messagerie (chat privé par userId)
    match /support_conversations/{convId} {
      allow read, write, delete: if isSignedIn() && (convId == request.auth.uid || isAdmin());

      match /{allSubcollections=**} {
        allow read, write, delete: if isSignedIn() && (convId == request.auth.uid || isAdmin());
      }
    }

    match /support_chats/{chatId} {
      allow read, write, delete: if isSignedIn() && (chatId == request.auth.uid || isAdmin());

      match /{allSubcollections=**} {
        allow read, write, delete: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      }
    }

    // 7. Paramètres publics et audit
    match /settings_pricing/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promo_codes/{promoId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
