rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin1@gmail.com' ||
        request.auth.token.email == 'admin1@gamil.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /user_profiles/{userId} {
      allow get, write, update: if (isSignedIn() && isValidId(userId) && userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
    }

    match /user_documents/{docId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (isSignedIn() && isValidId(docId) && incoming().userId == request.auth.uid) || isAdmin();
      allow update: if (isSignedIn() && isValidId(docId) && resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(docId) && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isValidId(orderId);
      allow read, list: if (isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data))) || isAdmin();
      allow update: if isValidId(orderId) || isAdmin();
    }

    match /transactions/{txId} {
      allow create: if isValidId(txId);
      allow read, list: if (isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data))) || isAdmin();
      allow update: if isValidId(txId) || isAdmin();
    }

    match /settings_pricing/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /promo_codes/{promoId} {
      allow read: if true;
      allow write, delete: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /test/connection {
      allow read: if true;
    }
  }
}

